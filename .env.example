OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-4.1-mini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Verified GraphRAG mode (legacy remains the compatibility default)
RESEARCH_MODE=legacy
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_GROUP_ID=neo4j
GRAPHRAG_MAX_ROUNDS=24
GRAPHRAG_MAX_ATTEMPTS_PER_SLOT=3
GRAPHRAG_SEARCH_RESULTS=5
GRAPHRAG_MAX_DOCUMENTS_PER_ROUND=3
COVERAGE_TARGET=1.0
MAX_NO_IMPROVEMENT_ROUNDS=4

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
